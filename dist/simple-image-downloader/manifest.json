{
  "manifest_version": 3,
  "name": "Simple Image Downloader",
  "version": "0.1.0",
  "description": "Find images on the current page, sort them by resolution, preview details, and download one image at a time.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Simple Image Downloader"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
